# Supabase (create a new project at supabase.com and grab these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Finnhub (free tier - get key at finnhub.io)
FINNHUB_API_KEY=your-finnhub-key

# Alpha Vantage (free tier - get key at alphavantage.co)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Anthropic (your existing key)
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: NewsAPI (free tier - get key at newsapi.org)
NEWS_API_KEY=your-news-api-key
